    {"name":"Validate DEMO creation input","type":"n8n-nodes-base.code","typeVersion":2,"parameters":{"jsCode":"const b=$input.first().json.body??$input.first().json,d=String(b.fecha_corte??'');const extras=Object.keys(b).filter(k=>!['fecha_corte','conversation_id','agent_turn'].includes(k));const iso=/^\\d{4}-\\d{2}-\\d{2}$/.test(d)&&new Date(d+'T00:00:00Z').toISOString().slice(0,10)===d;const technical=typeof b.conversation_id==='string'&&Number.isInteger(Number(b.agent_turn));if(!iso||d!=='2026-11-11'||extras.length||!technical)return[{json:{valid:false,http_status:400,error_code:'ENTRADA_DEMO_INVALIDA',message:'Sólo está disponible la fecha DEMO autorizada.'}}];const raw=`NOVA|${b.conversation_id}|CREATE|${d}`;let h=2166136261;for(const c of raw){h^=c.charCodeAt(0);h=Math.imul(h,16777619);}const token=(h>>>0).toString(36).toUpperCase().padStart(8,'0');const caso_id=`YC-NV${token}`;return[{json:{valid:true,fecha_corte:d,event_id:`EL-NOVA-${token}-CREATE-${d.replaceAll('-','')}`,caso_id,version_caso:1,version_curva:`CURVA-${caso_id}-V1`,execution_mode:'DEMO',canal_origen:'nova',invocation_id:`nova-${token}`}}];"}},
