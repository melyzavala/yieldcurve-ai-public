    {"name":"Validate query input","type":"n8n-nodes-base.code","typeVersion":2,"parameters":{"jsCode":"const b=$input.first().json.body??$input.first().json;const id=String(b.caso_id??'').trim();const valid=Object.keys(b).every(k=>['caso_id','conversation_id','agent_turn'].includes(k))&&/^YC-[A-Z0-9]{8,32}$/.test(id);return[{json:{valid,caso_id:id}}];"}},
