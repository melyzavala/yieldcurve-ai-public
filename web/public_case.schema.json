{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melyzavala.github.io/yieldcurve-ai/data/public_case.schema.json",
  "title": "YieldCurve AI public case",
  "type": "object",
  "additionalProperties": false,
  "required": ["public_schema_version", "case_id", "version_caso", "version_curva", "fecha_corte", "execution_mode", "publication_status", "publication_authorized", "published_at", "agentes", "fuente", "curva", "auditoria", "costos"],
  "properties": {
    "public_schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "version_caso": {"type": ["string", "integer", "null"]},
    "version_curva": {"type": ["string", "integer", "null"]},
    "fecha_corte": {"type": ["string", "null"]},
    "execution_mode": {"enum": ["DEMO", "LIVE"]},
    "publication_status": {"const": "PUBLISHED"},
    "publication_authorized": {"const": true},
    "published_at": {"type": "string", "format": "date-time"},
    "agentes": {"type": "object"},
    "fuente": {"type": "object", "required": ["source_mode"], "additionalProperties": false, "properties": {"source_mode": {"type": ["string", "null"]}}},
    "curva": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metodologia", "instrument_count", "max_absolute_repricing_error", "pillars"],
      "properties": {
        "metodologia": {"type": ["string", "null"]},
        "instrument_count": {"type": ["integer", "null"], "minimum": 0},
        "max_absolute_repricing_error": {"type": ["number", "null"]},
        "pillars": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["spot_rate"], "properties": {"spot_rate": {"type": "number"}}}},
        "curve_points": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["days", "time_years", "spot_rate", "point_type"], "properties": {"instrument_id": {"type": "string"}, "days": {"type": "integer", "minimum": 1}, "time_years": {"type": "number", "exclusiveMinimum": 0}, "spot_rate": {"type": "number"}, "discount_factor": {"type": "number", "exclusiveMinimum": 0}, "point_type": {"enum": ["PILLAR", "INTERPOLATED"]}, "left_pillar": {"type": "string"}, "right_pillar": {"type": "string"}, "source_method": {"const": "LINEAR_SPOT_RATE"}}}}
      }
    },
    "auditoria": {"type": ["object", "null"]},
    "costos": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_mode": {"const": "LIVE"}}},
      "then": {
        "properties": {
          "fuente": {
            "properties": {"source_mode": {"const": "BANXICO_SIE_LIVE"}}
          }
        }
      }
    }
  ]
}
